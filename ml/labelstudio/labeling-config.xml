<!-- NAMAA litter: one rectangle class. Paste into Settings > Labeling Interface > Code. -->
<View>
  <Header value="Box every litter item. No litter in the photo: submit with no boxes (clean photo)."/>
  <Image name="image" value="$image" zoom="true" zoomControl="true" rotateControl="false"/>
  <RectangleLabels name="label" toName="image" strokeWidth="2" opacity="0.4" canRotate="false">
    <Label value="litter" background="#e53935" hotkey="1"/>
  </RectangleLabels>
</View>
