# Secrets: real config files never enter Git. Templates (*.example) do.
.env
.env.*
!.env.example
firmware/**/secrets.h

# Firmware build output (PlatformIO)
firmware/**/.pio/

# Back (Laravel)
backend/vendor/
backend/node_modules/
backend/storage/*.key
backend/storage/logs/
backend/public/storage
backend/public/hot

# Front (React)
frontend/node_modules/
frontend/dist/

# Python (AI service)
__pycache__/
*.pyc
.venv/
venv/

# Large files: keep outside the repo, share a link instead
vision-service/models/*.pt
vision-service/models/*.onnx
data/recorded/*.mp4
data/recorded/*.tif
data/recorded/*.tiff
# Sample camera photos for the litter scenario: photos of public places may show people.
data/samples/
# pytest cache of the vision service
.pytest_cache/

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Training (local only, never committed)
ml/.venv/
ml/data/
ml/runs/
# Own photos for the demo tray / clean set (may show people)
ml/photos/
# Ultralytics downloads (fonts, weights) and caches
ml/weights/
*.cache
runs/
*.pt

# Park OSM exports (ODbL, refetched with namaa:parks:fetch-osm)
data/parks/osm/
