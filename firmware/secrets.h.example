// Settings for the sensor nodes (firmware/node-sensor/).
// The camera node does not use this file: see firmware/node-cam/README.md.
//
// Copy this file to secrets.h (kept out of Git) and fill in the values.
//
//   cp secrets.h.example secrets.h
#pragma once

// ---- Wi-Fi ------------------------------------------------------------------
// The node and the machine running Docker must be on the same network
// (a phone hotspot or a small router works well at the venue).
#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// ---- Server -----------------------------------------------------------------
// The LAN IP of the machine running Docker, NOT "localhost".
//   Windows: ipconfig      Linux/WSL: ip addr
// SERVER_PORT must match BACKEND_HOST_PORT in the root .env (default 8000).
#define SERVER_HOST   "192.168.0.10"
#define SERVER_PORT   8000
#define SERVER_PATH   "/api/readings"

// ---- This node --------------------------------------------------------------
// Unique per node (Model A, Model B, spare). The token is issued by the server for this node.
#define NODE_ID       1
#define NODE_TOKEN    "paste-node-token-here"

// How often the node reports, in milliseconds (docs/api.md suggests 30-60 s).
#define REPORT_INTERVAL_MS 30000
