# =============================================================================
# NAMAA - environment configuration
#
#   cp .env.example .env
#
# Docker Compose reads .env automatically. Laravel and the Python service get
# their settings from here, and URLs that depend on a port (APP_URL, ...) are
# derived from it. The React dashboard runs on the host and has its own small
# file, frontend/.env (copy frontend/.env.example). Real environment variables override
# Laravel's own backend/.env, so you can ignore that file.
#
# .env is ignored by Git. Never commit it.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Host ports
# -----------------------------------------------------------------------------
# These are the ports opened on YOUR machine. Containers talk to each other on
# fixed internal ports, so changing a value here never breaks the stack.
#
# The defaults are the standard ports, except MySQL (3308) so it does not clash
# with a MySQL already on your machine (3306 / 3307). If you ever see
# "port is already allocated", another program uses that port: change the
# number below and run:
#
#   docker compose up -d
#
#   Variable             Default   Reachable from
#   MYSQL_HOST_PORT      3308      this machine only (DBeaver, TablePlus, ...)
#   BACKEND_HOST_PORT    8000      the whole network (the ESP32 nodes use this)
#   REVERB_HOST_PORT     8080      the whole network (dashboard WebSocket)
#   VISION_HOST_PORT     8001      this machine only (debugging)
#
# The dashboard (Vite) uses its own default, 5173, and runs outside Docker.
#
# If you change BACKEND_HOST_PORT, also update SERVER_PORT in
# firmware/secrets.h and VITE_API_URL in frontend/.env.

MYSQL_HOST_PORT=3308
BACKEND_HOST_PORT=8000
REVERB_HOST_PORT=8080
VISION_HOST_PORT=8001


# -----------------------------------------------------------------------------
# 2. Database (MySQL)
# -----------------------------------------------------------------------------
# The database and user are created automatically the first time the mysql
# container starts. To apply new credentials later, reset the volume:
#   docker compose down -v      (this DELETES the database)

DB_DATABASE=namaa
DB_USERNAME=namaa
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root


# -----------------------------------------------------------------------------
# 3. Laravel
# -----------------------------------------------------------------------------
APP_NAME=NAMAA
APP_ENV=local
APP_DEBUG=true

# Generate once, after Laravel is installed:
#   docker compose run --rm backend php artisan key:generate --show
# Paste the printed value (starts with base64:) here. Everyone on the team can
# use their own key; it only needs to stay the same on your own machine.
APP_KEY=


# -----------------------------------------------------------------------------
# 4. Reverb (live dashboard updates over WebSocket)
# -----------------------------------------------------------------------------
# Any random strings work. Quick way to make one:  openssl rand -hex 16
REVERB_APP_ID=namaa
REVERB_APP_KEY=namaa-local-key
REVERB_APP_SECRET=namaa-local-secret


# -----------------------------------------------------------------------------
# 5. Python vision service
# -----------------------------------------------------------------------------
# uvicorn log level: critical | error | warning | info | debug | trace
VISION_LOG_LEVEL=info
# Satellite or model credentials go here when a provider is chosen.


# -----------------------------------------------------------------------------
# 6. Camera node (ESP32-S3-CAM)
# -----------------------------------------------------------------------------
# The camera runs the stock CameraWebServer example on the same Wi-Fi as this
# laptop. Laravel fetches a photo from <CAMERA_URL>/capture on a schedule.
# Find the camera's IP in the Arduino Serial Monitor after it boots
# ("Camera Ready! Use 'http://192.168.x.x' to connect"). A phone hotspot may
# give it a new IP after a restart: check it before the demo.
# Leave empty to switch the camera off.
CAMERA_URL=

# Shared password of the seeded demo accounts (admin@namaa.test,
# worker1@namaa.test, worker2@namaa.test, municipality@namaa.test).
# It must match the password the accounts were seeded with (default:
# password); the "Enter as Admin" / "Enter as Worker" buttons log in with it.
# Changing it here does not change the stored passwords.
DEMO_PASSWORD=password

# Demo mode. true switches on:
#   - fast timings: readings every 5 s, node offline after 30 s,
#     task verification after 1 min of normal readings, pump safety cut-off
#     after 3 min, simulator every 5 s, short response times and escalation
#   - the "Enter as Admin" / "Enter as Worker" buttons on the login page
#   - the /admin/demo page (scenario buttons)
# false = normal timings, no demo buttons, no demo page.
# The boards get the interval in every reading reply, so no re-flashing is
# needed: change it, then run  docker compose up -d
DEMO_MODE=false

# -----------------------------------------------------------------------------
# Derived automatically by docker-compose.yml (do not set these here)
# -----------------------------------------------------------------------------
#   APP_URL             -> http://localhost:<BACKEND_HOST_PORT>
#   DB_HOST / DB_PORT   -> mysql / 3306   (internal Docker network)
#   VISION_SERVICE_URL  -> http://vision:8001
#
# The dashboard is configured in frontend/.env, ESP32 nodes in firmware/secrets.h.
