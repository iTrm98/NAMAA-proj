// NAMAA sensor node: build-time defaults for Wi-Fi, server and node identity.
//
// Copy this file to secrets.h in the same folder (include/secrets.h is
// git-ignored) and fill in the values:
//
//   cp include/secrets.h.example include/secrets.h
//
// Without secrets.h the build uses this example file (and warns), so the board
// boots with placeholders; set the real values over serial instead:
//   set wifi1 <ssid> <pass>   set host <ip>   set node <id> <token>   reboot
// Values set over serial are saved on the board (NVS) and win over this file
// until `factory`.
//
// This is the only secrets template for the sensor node. The camera node does not
// use it (see firmware/node-cam/README.md).
#pragma once

// ---- Wi-Fi: tried in order, 1 then 2 -------------------------------------------
// 1: the laptop's Windows Mobile Hotspot.
#define WIFI_SSID_1 "NAMAA-laptop"
#define WIFI_PASS_1 "change-me"
// 2: a phone hotspot (backup). Leave "" to skip.
#define WIFI_SSID_2 ""
#define WIFI_PASS_2 ""

// ---- Server (the laptop running Docker) ------------------------------------------
// Windows Mobile Hotspot gives the laptop 192.168.137.1. On another network use the
// laptop's LAN IP (ipconfig), never "localhost".
#define SERVER_HOST "192.168.137.1"
// Must match BACKEND_HOST_PORT in the root .env (default 8000).
#define SERVER_PORT 8000

// ---- This node ----------------------------------------------------------------------
// The node id and its device token from the server (admin hardware page / seeder).
#define NODE_ID 1
#define NODE_TOKEN "paste-node-token-here"
