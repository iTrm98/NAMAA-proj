# Settings for the React dashboard (it runs on your machine, not in Docker).
#
#   cp .env.example .env        (run inside frontend/)
#
# Vite only exposes variables that start with VITE_.

# Laravel API. Must match BACKEND_HOST_PORT in the root .env.
VITE_API_URL=http://localhost:8000

# Reverb WebSocket. The key must match REVERB_APP_KEY in the root .env,
# the port must match REVERB_HOST_PORT.
VITE_REVERB_APP_KEY=namaa-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# MapTiler key for the satellite basemap (free account at https://cloud.maptiler.com,
# "API keys"). Leave empty to use the OpenStreetMap street map instead.
# Never commit the real key: it belongs in frontend/.env only.
VITE_MAPTILER_KEY=
